# Copiar a .env.local para sobreescribir en desarrollo (por ejemplo, para
# apuntar a un relé local levantado con `go run .` en hivescope-relay).
VITE_RELAY_URL=wss://relay.hivescope.xyz

# Cuenta Hive que ve el botón "editar" en CUALQUIER sala (no solo las que
# posee/administra), porque hivescope-relay la trata como superadmin --
# tiene que coincidir con HIVESCOPE_SUPERADMIN_HIVE_ACCOUNT en el relé, o el
# botón aparecería sin que la edición fuera a ser aceptada. Vacío = nadie
# tiene este atajo de UI (el relé decide igual, esto es solo cosmético).
VITE_SUPERADMIN_HIVE_ACCOUNT=rzazo24
